# Saamu Tailors Backend Environment Variables Example
# Copy this file to .env and update values for your deployment.
# Never commit the real .env file.

# Secret key for production (change in real deployment)
SECRET_KEY=django-insecure-saamu-tailors-dev-key-change-in-production-123456

# Debug mode (set to False in production)
DEBUG=True

# PostgreSQL Database Settings
DATABASE_NAME=saamu_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (comma-separated)
# Local development defaults cover the Vite dev server. The Vite port can
# drift from 5173 when that port is already in use, so 5173 and 5175 are both
# listed. Add/remove origins for your deployment (localhost vs 127.0.0.1 are
# different origins; both are included for local dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Application Settings
TIME_ZONE=Asia/Kolkata

# Logging (optional; defaults: LOG_LEVEL=INFO, LOG_DIR=backend/logs)
LOG_LEVEL=INFO
# LOG_DIR=C:/path/to/logs

# Static / Media (optional; defaults are relative to backend/ and cloud-overridable)
# STATIC_ROOT=
# MEDIA_ROOT=
