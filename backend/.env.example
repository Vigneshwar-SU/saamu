# Saamu Tailors Backend Environment Variables Example
# Copy this file to .env and update values for your deployment.
# Never commit the real .env file.

# Secret key for production (change in real deployment)
SECRET_KEY=django-insecure-saamu-tailors-dev-key-change-in-production-123456

# Debug mode (set to False in production)
DEBUG=True

# PostgreSQL Database Settings
# Values below are local-development defaults. With DEBUG=False the
# application validates that every database setting is provided explicitly
# (see the Production Configuration section at the bottom of this file).
DATABASE_NAME=saamu_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Backup / restore storage (Phase 16)
# Default: %USERPROFILE%\SaamuBackups (outside the source tree).
# Never point BACKUP_DIR inside the repository; backups are never committed.
BACKUP_DIR=D:\SaamuBackups
# Optional: directory containing pg_dump / pg_restore / psql.
# When empty, the tools are located on PATH. Example for PostgreSQL 18:
# PGBIN=C:\Program Files\PostgreSQL\18\bin

# CORS Allowed Origins (comma-separated)
# Local development defaults cover the Vite dev server. The Vite port can
# drift from 5173 when that port is already in use, so 5173 and 5175 are both
# listed. Add/remove origins for your deployment (localhost vs 127.0.0.1 are
# different origins; both are included for local dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Security / HTTPS (Phase 21)
# Local development uses plain HTTP, so secure cookies, HSTS and the proxy
# header are OFF by default. In production set them explicitly; HSTS must only
# be enabled once the HTTPS/domain topology is ready.
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_PROXY_SSL_HEADER=True   # ONLY when behind a TLS-terminating proxy
# Optional local overrides (defaults shown):
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
# SESSION_COOKIE_SAMESITE=Lax

# Email / Password Reset (Phase 22)
# Password reset links are emailed to OWNER and STAFF accounts via SMTP. The
# values below are the Gmail defaults; Gmail requires an App Password (not the
# account password) which must only live in the local .env - never commit it.
# With DEBUG=False the production validation requires EMAIL_HOST,
# EMAIL_HOST_USER, EMAIL_HOST_PASSWORD and DEFAULT_FROM_EMAIL to be set.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=saamutailors1954@gmail.com
# EMAIL_HOST_PASSWORD=REPLACE-WITH-GMAIL-APP-PASSWORD
DEFAULT_FROM_EMAIL=Saamu Tailors <saamutailors1954@gmail.com>
# Base URL of the frontend used to build password reset links in emails.
FRONTEND_URL=http://localhost:5173
# Reset link lifetime in seconds (default 900 = 15 minutes).
PASSWORD_RESET_TIMEOUT=900
# Optional rate-limit overrides (defaults shown):
# PASSWORD_RESET_REQUEST_RATE=5/hour
# PASSWORD_RESET_CONFIRM_RATE=30/hour

# Application Settings
TIME_ZONE=Asia/Kolkata

# Logging (optional; defaults: LOG_LEVEL=INFO, LOG_DIR=backend/logs)
LOG_LEVEL=INFO
# LOG_DIR=C:/path/to/logs

# Static / Media (optional; defaults are relative to backend/ and cloud-overridable)
# STATIC_ROOT=
# MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Production Configuration (Phase 20/21)
# ---------------------------------------------------------------------------
# Set DEBUG=False to enable explicit production validation. The application
# will then refuse to start until every required setting below is provided
# and the secret values are not the development defaults. Errors name only the
# configuration category - secrets are never printed. The values shown are
# safe placeholders; never commit real credentials.
#
# DEBUG=False
# SECRET_KEY=replace-with-a-long-random-secret
# ALLOWED_HOSTS=api.example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# FRONTEND_URL=https://app.example.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=saamutailors1954@gmail.com
# EMAIL_HOST_PASSWORD=REPLACE-WITH-GMAIL-APP-PASSWORD
# DEFAULT_FROM_EMAIL=Saamu Tailors <saamutailors1954@gmail.com>
# DATABASE_NAME=saamu_cloud
# DATABASE_USER=saamu_app
# DATABASE_PASSWORD=replace-with-a-strong-password
# DATABASE_HOST=db.example.com
# DATABASE_PORT=5432
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_PROXY_SSL_HEADER=True
#
# The same codebase and PostgreSQL target work locally or in the cloud; only
# these environment values differ. Backups (Phase 16) remain outside the
# source tree and are the authoritative portability mechanism.
