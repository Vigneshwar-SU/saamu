# Frontend Environment Variables Example
# Copy to .env and adjust for your environment. Never commit the real .env.
VITE_API_BASE_URL=https://pc6w9n8f-8000.inc1.devtunnels.ms/api/v1
VITE_APP_TITLE=Saamu Tailors

# Production build (Phase 21): set VITE_API_BASE_URL to the deployed backend
# URL before building the production bundle. VITE_* variables are embedded
# into the build output, so they must only ever contain public values - never
# backend credentials or secrets.
# VITE_API_BASE_URL=https://api.example.com/api/v1
